<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "DoNow" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="DoNow">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <%= link_to "DoNow", root_path, class: "brand" %>
        <% if authenticated? %>
          <nav class="main-nav" aria-label="メインナビゲーション">
            <%= link_to "今日", root_path %>
            <%= link_to "タスク", tasks_path %>
            <%= link_to "目標", goals_path %>
            <%= link_to "履歴", history_path %>
            <span class="account-email"><%= Current.user.email_address %></span>
            <%= button_to "ログアウト", session_path, method: :delete, class: "nav-logout" %>
          </nav>
        <% end %>
      </div>
    </header>

    <main class="container page-content">
      <% if notice.present? %>
        <p class="flash flash-notice"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="flash flash-alert"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
