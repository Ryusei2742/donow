<% content_for :title, "目標 | DoNow" %>

<div class="page-heading">
  <div>
    <p class="eyebrow">FUTURE PATHS</p>
    <h1>目標</h1>
    <p>小さな行動が、どの未来につながるのかを言葉にしておきましょう。</p>
  </div>
  <%= link_to "+ 目標を追加", new_goal_path, class: "button button-primary" %>
</div>

<% if @goals.any? %>
  <div class="goal-list">
    <% @goals.each do |goal| %>
      <article class="goal-card">
        <div class="goal-card-header">
          <div>
            <% if goal.target_date %>
              <p class="goal-date">目標日 <%= format_date(goal.target_date) %></p>
            <% end %>
            <h2><%= link_to goal.title, goal %></h2>
          </div>
          <span class="goal-start-count"><strong><%= goal.starts_this_week_count %></strong>回<br>今週の着手</span>
        </div>
        <p class="future-label">近づきたい未来</p>
        <p class="future-text"><%= goal.desired_future %></p>
        <%= link_to "詳しく見る", goal, class: "text-link" %>
      </article>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">
    <h2>近づきたい未来を書いてみましょう</h2>
    <p>大きな目標でなくても構いません。今の自分が大切にしたい変化を登録できます。</p>
    <%= link_to "最初の目標を作る", new_goal_path, class: "button button-primary" %>
  </div>
<% end %>
