<% content_for :title, "集中タイマー | DoNow" %>

<section
  class="focus-panel"
  data-controller="countdown"
  <% if @active_session %>
    data-countdown-end-at-value="<%= @active_session.ends_at.iso8601(3) %>"
  <% end %>
>
  <p class="eyebrow">JUST FIVE MINUTES</p>

  <% if @active_session %>
    <% remaining_seconds = @active_session.remaining_seconds %>
    <% expired = remaining_seconds.zero? %>

    <h1>今はこのタスクだけ</h1>
    <p class="focus-task"><%= @active_session.task.title %></p>
    <% if @active_session.task.goal %>
      <p class="focus-goal-name">目標：<%= @active_session.task.goal.title %></p>
    <% end %>
    <p class="focus-session-meta">
      <%= l(@active_session.started_at, format: :short) %> 開始
      ・合計 <%= @active_session.planned_duration_seconds / 60 %>分
    </p>

    <% if @active_session.avoidance_rule_title.present? %>
      <aside class="focus-avoidance" aria-label="この5分でやらないこと">
        <span>この5分でやらないこと</span>
        <strong><%= @active_session.avoidance_rule_title %></strong>
      </aside>
    <% end %>

    <div class="timer" data-countdown-target="display" aria-live="polite">
      <%= format("%d:%02d", remaining_seconds / 60, remaining_seconds % 60) %>
    </div>
    <p class="timer-message" data-countdown-target="message">
      <%= expired ? "時間になりました。次の行動を選びましょう。" : "今はこの時間だけに集中しましょう。" %>
    </p>

    <div class="focus-running-actions" data-countdown-target="running" <%= "hidden" if expired %>>
      <%= button_to "中断する", interrupt_focus_path(@active_session), method: :patch, class: "button button-quiet" %>
    </div>

    <div class="focus-outcome" data-countdown-target="outcome" <%= "hidden" unless expired %>>
      <h2>ここまでできました</h2>
      <p>続けるか、区切りをつけるかを選んでください。</p>
      <div class="focus-outcome-actions">
        <%= button_to "完了する", complete_focus_path(@active_session), method: :patch, class: "button button-success" %>
        <%= button_to "5分延長する", extend_focus_path(@active_session), method: :patch, params: { seconds: 5.minutes.to_i }, class: "button button-primary" %>
        <%= button_to "10分延長する", extend_focus_path(@active_session), method: :patch, params: { seconds: 10.minutes.to_i }, class: "button button-secondary" %>
        <%= button_to "中断する", interrupt_focus_path(@active_session), method: :patch, class: "button button-quiet" %>
      </div>
    </div>

    <% if @active_session.task.goal %>
      <article class="future-branch-card" aria-labelledby="future-branch-title">
        <p class="eyebrow">FUTURE PATH</p>
        <h2 id="future-branch-title">この5分がつながる未来</h2>
        <div class="future-branch-section future-branch-desired">
          <p class="future-label">近づきたい未来</p>
          <p class="future-text"><%= @active_session.task.goal.desired_future %></p>
        </div>
        <div class="future-branch-section future-branch-avoided">
          <p class="future-label">先延ばしした場合に続く可能性がある状態</p>
          <p class="future-context">状況が急に悪化すると決まっているわけではありません。そのうえで、次の状態が続く可能性があります。</p>
          <p class="future-text"><%= @active_session.task.goal.avoided_future %></p>
        </div>
      </article>
    <% end %>
  <% else %>
    <h1>まず5分だけやりましょう</h1>
    <p class="muted">取りかかるタスクのボタンを押すと、すぐに始まります。開始後は、ブラウザを閉じても続きから復元できます。</p>

    <% if @tasks.any? %>
      <div class="focus-task-list">
        <% @tasks.each do |task| %>
          <div class="focus-task-option">
            <div>
              <strong><%= task.title %></strong>
              <% if task.goal %>
                <span>目標：<%= task.goal.title %></span>
              <% end %>
            </div>
            <%= render "focus/start_form",
                       task: task,
                       button_label: "5分始める",
                       location: "focus-list" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state focus-empty-state">
        <p>開始できるタスクがありません。</p>
        <%= link_to "タスクを作成する", new_task_path, class: "button button-primary" %>
      </div>
    <% end %>
  <% end %>

  <%= link_to "今日の画面へ戻る", root_path, class: "text-link back-link" %>
</section>
